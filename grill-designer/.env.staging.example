# Mr. Sprinkle Gold Grill Designer 2.0 — STAGING environment template
# Copy to .env.staging and fill in staging-only values. Never commit the copy.
# Never put production credentials here.

# Must be exactly "staging". The server refuses to start with any other value.
GGD_APP_ENV=staging

# Port the staging API listens on inside the sandbox.
GGD_PORT=8800

# SQLite file for the staging database. Must stay inside grill-designer/var/.
GGD_DB_PATH=var/staging.db

# Folder for staging uploads (reference photos). Must stay inside grill-designer/var/.
GGD_UPLOAD_DIR=var/uploads

# Notification mode. Only "outbox" is allowed in staging: notifications are
# written to var/outbox/ as files and never sent by email, SMS, Formspree,
# Google Sheets, Zapier, or any other live service.
GGD_NOTIFY_MODE=outbox

# Staging admin login (Milestone 6). Set a staging-only value; never reuse a production password.
GGD_ADMIN_PASSWORD_HASH=
